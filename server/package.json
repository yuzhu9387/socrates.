{
  "name": "socrates-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.mjs",
    "dev": "node --env-file-if-exists=../.env --watch src/index.mjs",
    "migrate": "node --env-file-if-exists=../.env src/cli.mjs migrate",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 tests/*.test.mjs",
    "mcp": "node --env-file-if-exists=../.env src/mcp-stdio.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "zod": "4.5.4"
  }
}
